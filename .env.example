# ============================================================================
# AVAHUI MONOREPO — ROOT ENVIRONMENT EXAMPLE (DOCKER COMPOSE & GLOBAL)
# Copy this file to `.env` before running `docker compose up`
# ============================================================================

# --- Environment Mode ---
NODE_ENV=development

# --- PostgreSQL Database Container ---
POSTGRES_USER=avahui_user
POSTGRES_PASSWORD=avahui_secret_password_change_me
POSTGRES_DB=avahui_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://avahui_user:avahui_secret_password_change_me@localhost:5433/avahui_db?schema=public

# --- Backend Service (NestJS) ---
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# --- Frontend Service (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Privy Authentication & Embedded Wallet ---
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# --- Blockchain Network (Avalanche Fuji Testnet) ---
CHAIN_ID=43113
NEXT_PUBLIC_CHAIN_ID=43113
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
BLOCK_EXPLORER_URL=https://testnet.snowtrace.io
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet.snowtrace.io

# --- Smart Contract Addresses (Fuji Testnet) ---
ROSCA_FACTORY_ADDRESS=
NEXT_PUBLIC_ROSCA_FACTORY_ADDRESS=
USDC_TOKEN_ADDRESS=
NEXT_PUBLIC_USDC_TOKEN_ADDRESS=

# --- AI Future Module (Disabled in MVP by default) ---
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
