# ============================================================================
# @avahui/web — FRONTEND ENVIRONMENT EXAMPLE (Next.js)
# Copy to `apps/web/.env.local` for local standalone frontend development.
# WARNING: Never store private keys or backend secrets in NEXT_PUBLIC_* vars!
# ============================================================================

# --- Parallel Development Mock Toggle ---
# Set to "true" to run Frontend 100% standalone using mock data & simulated tx
# Set to "false" to connect to real NestJS API + Avalanche Fuji Smart Contracts
NEXT_PUBLIC_USE_MOCK=true

# --- Backend REST API ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Privy Embedded Wallet (Public App ID only) ---
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# --- Avalanche Fuji C-Chain Configuration ---
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet.snowtrace.io

# --- Deployed Smart Contract Addresses ---
NEXT_PUBLIC_ROSCA_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
