# ============================================================================
# @avahui/api — BACKEND ENVIRONMENT EXAMPLE (NestJS + Prisma + Indexer)
# Copy to `apps/api/.env` for local backend development.
# ============================================================================

# --- Server Config ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# --- PostgreSQL Database (Prisma) ---
DATABASE_URL=postgresql://avahui_user:avahui_secret_password_change_me@localhost:5433/avahui_db?schema=public

# --- Privy Server Authentication Verification ---
PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here
PRIVY_VERIFICATION_KEY=
AUTH_JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
ALLOW_DEV_MOCK_AUTH=false
BOOTSTRAP_ADMIN_EMAILS=

# --- Blockchain RPC & Event Indexer Configuration ---
CHAIN_ID=43113
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
BLOCK_EXPLORER_URL=https://testnet.snowtrace.io
ROSCA_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
USDC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
YIELD_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
SYBIL_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
KEEPER_ENABLED=true
KEEPER_PRIVATE_KEY=
VERIFIER_ISSUER_PRIVATE_KEY=

# Indexer polling & safety settings
INDEXER_ENABLED=true
INDEXER_START_BLOCK=0
INDEXER_POLL_INTERVAL_MS=3000
INDEXER_CONFIRMATION_BLOCKS=2

# --- Rate Limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- AI Module (Future Expansion — Informational Only) ---
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
