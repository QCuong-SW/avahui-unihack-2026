{
  "name": "@avahui/api",
  "version": "0.1.0",
  "private": true,
  "description": "AvaHui NestJS Backend API & Blockchain Event Indexer",
  "scripts": {
    "prebuild": "tsc -p ../../packages/shared/tsconfig.json && tsc -p ../../packages/blockchain/tsconfig.json",
    "build": "nest build",
    "prestart": "tsc -p ../../packages/shared/tsconfig.json && tsc -p ../../packages/blockchain/tsconfig.json",
    "start": "nest start",
    "prestart:dev": "tsc -p ../../packages/shared/tsconfig.json && tsc -p ../../packages/blockchain/tsconfig.json",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:deploy": "node scripts/start-prod.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seeds/seed.ts",
    "db:reset-seed": "node scripts/reset-db.js && ts-node prisma/seeds/seed.ts",
    "deploy:fuji": "node scripts/deploy-fuji.js",
    "verify:fuji": "node scripts/verify-fuji.js"
  },
  "dependencies": {
    "@avahui/blockchain": "workspace:*",
    "@avahui/shared": "workspace:*",
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "viem": "^2.21.45"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "solc": "^0.8.24",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
