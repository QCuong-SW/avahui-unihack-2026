// ============================================================================
// @avahui/api — Full Prisma Schema
// Database: PostgreSQL (13 Tables + 6 Enums)
// Maps 100% to infrastructure/database/init/01-init-schema.sql
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  VERIFIER
  ADMIN

  @@map("user_role")
}

enum AllocationMode {
  FIXED
  BIDDING

  @@map("allocation_mode")
}

enum CircleStatus {
  DRAFT
  RECRUITING
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("circle_status")
}

enum RoundStatus {
  PENDING
  OPEN
  SETTLED

  @@map("round_status")
}

enum MemberStatus {
  ACTIVE
  DEFAULTED
  WITHDRAWN

  @@map("member_status")
}

enum TxType {
  FAUCET_MINT
  APPROVE_TOKEN
  CREATE_CIRCLE
  JOIN_CIRCLE
  CONTRIBUTE
  PLACE_BID
  COMMIT_BID
  REVEAL_BID
  SETTLE_ROUND
  WITHDRAW_COLLATERAL
  CANCEL_CIRCLE
  SWAP_TOKEN
  VERIFY_ATTESTATION

  @@map("tx_type")
}

enum TxStatus {
  PENDING
  CONFIRMED
  FAILED

  @@map("tx_status")
}

model User {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  privyDid          String   @unique @map("privy_did") @db.VarChar(128)
  email             String?  @unique @db.VarChar(255)
  displayName       String?  @map("display_name") @db.VarChar(100)
  avatarUrl         String?  @map("avatar_url")
  role              UserRole @default(MEMBER)
  isActive          Boolean  @default(true) @map("is_active")
  team1Verified     Boolean  @default(false) @map("team1_verified")
  identityNullifier String?  @unique @map("identity_nullifier") @db.VarChar(66)
  trustTier         Int      @default(0) @map("trust_tier") @db.SmallInt
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  wallets       Wallet[]
  memberships   CircleMember[]
  notifications Notification[]

  @@index([role], map: "idx_users_role")
  @@map("users")
}

model AuthNonce {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  address   String    @db.VarChar(42)
  nonce     String    @unique @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([address], map: "idx_auth_nonces_address")
  @@map("auth_nonces")
}

model Wallet {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  address          String   @unique @db.VarChar(42)
  walletClientType String   @default("privy") @map("wallet_client_type") @db.VarChar(50)
  isPrimary        Boolean  @default(true) @map("is_primary")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_wallets_user_id")
  @@index([address], map: "idx_wallets_address")
  @@map("wallets")
}

model Circle {
  id                     String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  metadataId             String         @unique @map("metadata_id") @db.VarChar(64)
  contractAddress        String?        @unique @map("contract_address") @db.VarChar(42)
  chainId                Int            @default(43113) @map("chain_id")
  name                   String         @db.VarChar(120)
  description            String?
  creatorAddress         String         @map("creator_address") @db.VarChar(42)
  tokenAddress           String         @map("token_address") @db.VarChar(42)
  allocationMode         AllocationMode @map("allocation_mode")
  status                 CircleStatus   @default(DRAFT)
  maxMembers             Int            @map("max_members") @db.SmallInt
  currentMemberCount     Int            @default(0) @map("current_member_count") @db.SmallInt
  currentRound           Int            @default(0) @map("current_round") @db.SmallInt
  totalRounds            Int            @map("total_rounds") @db.SmallInt
  contributionAmount     Decimal        @map("contribution_amount") @db.Decimal(78, 0)
  collateralAmount       Decimal        @map("collateral_amount") @db.Decimal(78, 0)
  roundDurationSeconds   Int            @map("round_duration_seconds")
  biddingDurationSeconds Int            @default(0) @map("bidding_duration_seconds")
  gracePeriodSeconds     Int            @map("grace_period_seconds")
  startDeadline          DateTime       @map("start_deadline") @db.Timestamptz(6)
  minBid                 Decimal        @default(0) @map("min_bid") @db.Decimal(78, 0)
  maxBid                 Decimal        @default(0) @map("max_bid") @db.Decimal(78, 0)
  totalDiscountPool       Decimal        @default(0) @map("total_discount_pool") @db.Decimal(78, 0)
  isPrivateInvite         Boolean        @default(false) @map("is_private_invite")
  inviteCodeHash          String?        @map("invite_code_hash") @db.VarChar(66)
  requireTeam1Attestation Boolean        @default(false) @map("require_team1_attestation")
  isHiddenByAdmin         Boolean        @default(false) @map("is_hidden_by_admin")
  moderationReason        String?        @map("moderation_reason")
  creationTxHash          String?        @map("creation_tx_hash") @db.VarChar(66)
  activatedAt            DateTime?      @map("activated_at") @db.Timestamptz(6)
  completedAt            DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members       CircleMember[]
  collaterals   Collateral[]
  rounds        Round[]
  contributions Contribution[]
  bids          Bid[]
  payouts       Payout[]
  transactions  BlockchainTransaction[]
  notifications Notification[]

  @@index([status], map: "idx_circles_status")
  @@index([creatorAddress], map: "idx_circles_creator")
  @@index([contractAddress], map: "idx_circles_contract")
  @@map("circles")
}

model CircleMember {
  id                String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  circleId          String       @map("circle_id") @db.Uuid
  userId            String?      @map("user_id") @db.Uuid
  memberAddress     String       @map("member_address") @db.VarChar(42)
  slotIndex         Int          @map("slot_index") @db.SmallInt
  status            MemberStatus @default(ACTIVE)
  hasReceivedPayout Boolean      @default(false) @map("has_received_payout")
  wonRoundNumber    Int?         @map("won_round_number") @db.SmallInt
  defaultCount      Int          @default(0) @map("default_count") @db.SmallInt
  joinTxHash        String       @map("join_tx_hash") @db.VarChar(66)
  joinedAt          DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)

  circle     Circle      @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  collateral Collateral?

  @@unique([circleId, memberAddress])
  @@unique([circleId, slotIndex])
  @@index([memberAddress], map: "idx_circle_members_address")
  @@map("circle_members")
}

model Collateral {
  id                   String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  circleId             String   @map("circle_id") @db.Uuid
  memberId             String   @unique @map("member_id") @db.Uuid
  memberAddress        String   @map("member_address") @db.VarChar(42)
  initialLockedAmount  Decimal  @map("initial_locked_amount") @db.Decimal(78, 0)
  currentLockedAmount  Decimal  @map("current_locked_amount") @db.Decimal(78, 0)
  totalSlashedAmount   Decimal  @default(0) @map("total_slashed_amount") @db.Decimal(78, 0)
  withdrawnAmount      Decimal  @default(0) @map("withdrawn_amount") @db.Decimal(78, 0)
  discountBonusClaimed Decimal  @default(0) @map("discount_bonus_claimed") @db.Decimal(78, 0)
  isWithdrawn          Boolean  @default(false) @map("is_withdrawn")
  withdrawTxHash       String?  @map("withdraw_tx_hash") @db.VarChar(66)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  circle Circle       @relation(fields: [circleId], references: [id], onDelete: Cascade)
  member CircleMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("collaterals")
}

model Round {
  id                   String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  circleId             String      @map("circle_id") @db.Uuid
  roundNumber          Int         @map("round_number") @db.SmallInt
  status               RoundStatus @default(PENDING)
  startTime            DateTime?   @map("start_time") @db.Timestamptz(6)
  contributionDeadline DateTime?   @map("contribution_deadline") @db.Timestamptz(6)
  biddingDeadline      DateTime?   @map("bidding_deadline") @db.Timestamptz(6)
  graceDeadline        DateTime?   @map("grace_deadline") @db.Timestamptz(6)
  winnerAddress        String?     @map("winner_address") @db.VarChar(42)
  grossPotAmount       Decimal     @default(0) @map("gross_pot_amount") @db.Decimal(78, 0)
  winningBidAmount     Decimal     @default(0) @map("winning_bid_amount") @db.Decimal(78, 0)
  netPayoutAmount      Decimal     @default(0) @map("net_payout_amount") @db.Decimal(78, 0)
  settledAt            DateTime?   @map("settled_at") @db.Timestamptz(6)
  settlementTxHash     String?     @map("settlement_tx_hash") @db.VarChar(66)

  circle        Circle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  contributions Contribution[]
  bids          Bid[]
  payout        Payout?

  @@unique([circleId, roundNumber])
  @@index([circleId, status], map: "idx_rounds_circle_status")
  @@map("rounds")
}

model Contribution {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  circleId              String   @map("circle_id") @db.Uuid
  roundId               String   @map("round_id") @db.Uuid
  roundNumber           Int      @map("round_number") @db.SmallInt
  memberAddress         String   @map("member_address") @db.VarChar(42)
  amount                Decimal  @db.Decimal(78, 0)
  isFromCollateralSlash Boolean  @default(false) @map("is_from_collateral_slash")
  txHash                String   @map("tx_hash") @db.VarChar(66)
  contributedAt         DateTime @default(now()) @map("contributed_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([circleId, roundNumber, memberAddress])
  @@index([memberAddress], map: "idx_contributions_member")
  @@map("contributions")
}

model Bid {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  circleId      String   @map("circle_id") @db.Uuid
  roundId       String   @map("round_id") @db.Uuid
  roundNumber   Int      @map("round_number") @db.SmallInt
  bidderAddress String   @map("bidder_address") @db.VarChar(42)
  bidAmount     Decimal  @map("bid_amount") @db.Decimal(78, 0)
  isWinningBid  Boolean  @default(false) @map("is_winning_bid")
  txHash        String   @map("tx_hash") @db.VarChar(66)
  placedAt      DateTime @default(now()) @map("placed_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, bidAmount(sort: Desc)], map: "idx_bids_round")
  @@map("bids")
}

model Payout {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  circleId         String   @map("circle_id") @db.Uuid
  roundId          String   @unique @map("round_id") @db.Uuid
  roundNumber      Int      @map("round_number") @db.SmallInt
  recipientAddress String   @map("recipient_address") @db.VarChar(42)
  grossAmount      Decimal  @map("gross_amount") @db.Decimal(78, 0)
  discountAmount   Decimal  @default(0) @map("discount_amount") @db.Decimal(78, 0)
  netAmount        Decimal  @map("net_amount") @db.Decimal(78, 0)
  txHash           String   @map("tx_hash") @db.VarChar(66)
  paidAt           DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([circleId, roundNumber])
  @@unique([circleId, recipientAddress])
  @@map("payouts")
}

model BlockchainTransaction {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  chainId         Int       @default(43113) @map("chain_id")
  txHash          String    @unique @map("tx_hash") @db.VarChar(66)
  senderAddress   String    @map("sender_address") @db.VarChar(42)
  contractAddress String    @map("contract_address") @db.VarChar(42)
  circleId        String?   @map("circle_id") @db.Uuid
  txType          TxType    @map("tx_type")
  status          TxStatus  @default(PENDING)
  blockNumber     BigInt?   @map("block_number")
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)

  circle Circle? @relation(fields: [circleId], references: [id], onDelete: SetNull)

  @@index([senderAddress], map: "idx_tx_sender")
  @@map("blockchain_transactions")
}

model BlockchainEvent {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  chainId         Int      @default(43113) @map("chain_id")
  txHash          String   @map("tx_hash") @db.VarChar(66)
  logIndex        Int      @map("log_index")
  blockNumber     BigInt   @map("block_number")
  blockTimestamp  DateTime @map("block_timestamp") @db.Timestamptz(6)
  contractAddress String   @map("contract_address") @db.VarChar(42)
  eventName       String   @map("event_name") @db.VarChar(80)
  payload         Json
  processed       Boolean  @default(true)
  processedAt     DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([chainId, txHash, logIndex])
  @@index([blockNumber], map: "idx_events_block_number")
  @@map("blockchain_events")
}

model IndexerState {
  chainId            Int      @id @map("chain_id")
  lastProcessedBlock BigInt   @default(0) @map("last_processed_block")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("indexer_state")
}

model Notification {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  circleId  String?  @map("circle_id") @db.Uuid
  title     String   @db.VarChar(160)
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle Circle? @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([userId, isRead], map: "idx_notifications_user_unread")
  @@map("notifications")
}
