# ============================================================================
# AVAHUI MONOREPO — .gitignore
# ============================================================================

# 1. Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
.pnpm-debug.log*
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# 2. Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.local
.env.development
.env.test
.env.staging
.env.production
.env.*.local
!.env.example
*.pem
*.key
*.p12
*.pfx
*.secret
secrets/

# 3. Frontend (Next.js)
apps/web/.next/
apps/web/out/
apps/web/build/
next-env.d.ts
*.tsbuildinfo

# 4. Backend (NestJS & Prisma)
apps/api/dist/
dist/
build/

# 5. Smart Contracts (Foundry / Solidity)
apps/contracts/cache/
apps/contracts/out/
apps/contracts/broadcast/
apps/contracts/artifacts/
apps/contracts/typechain-types/
lcov.info

# 6. Database & Docker Volumes
postgres_data/
pgdata/
infrastructure/database/backups/*.sql
infrastructure/database/backups/*.dump
infrastructure/database/backups/*.gz
*.db
*.sqlite
*.sqlite3

# 7. Testing & Coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# 8. Logs & Runtime Data
logs/
*.log
pids
*.pid
*.seed
*.pid.lock

# 9. IDEs & Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
*.iml

# 10. Operating System Files (Windows / macOS / Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 11. Temporary / Scratch Files
tmp/
temp/
.temp/
.cache/
.turbo/
